{
  "name": "A2A Student Peer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "forwardPorts": [7860, 8000],
  "portsAttributes": {
    "7860": {"label": "Student Gradio UI", "onAutoForward": "notify"},
    "8000": {"label": "Student A2A endpoint", "onAutoForward": "notify"}
  },
  "remoteEnv": {
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "INSTRUCTOR_REGISTRY_URL": "${localEnv:INSTRUCTOR_REGISTRY_URL}"
  }
}
